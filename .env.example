# Argus instance
ARGUS_URL=http://your-argus-host:8080
ARGUS_USERNAME=your_username
ARGUS_PASSWORD=your_password

# OpenRouter LLM API (https://openrouter.ai)
OPENROUTER_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=stepfun/step-3.5-flash:free

# Microsoft Teams webhook (Power Automate flow trigger URL)
TEAMS_WEBHOOK_URL=https://your-power-automate-webhook-url

# GitHub API token (optional — increases rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=ghp_your_token_here

# Log file path (optional — default: argus_monitor.log in working directory)
# LOG_FILE=argus_monitor.log

# Seconds between periodic full re-scans (optional — default: 3600 = 1 hour)
# SCAN_INTERVAL=3600
